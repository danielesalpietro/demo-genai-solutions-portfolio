# Private RAG demo — copy to .env and fill in your values before starting
# docker compose --env-file .env up -d

# --- Required ---
# Secret key for Open WebUI session signing (min 32 characters)
WEBUI_SECRET_KEY=CHANGE_ME_32_CHAR_MIN_SECRET_KEY

# --- Optional ---
# Host port for the Open WebUI interface (default: 3000)
DEMO_PORT=3000

# Additional OpenAI-compatible base URLs (comma-separated, leave blank for Ollama-only mode)
OPENAI_API_BASE_URLS=

# Qdrant API key for the vector store (leave blank to run without auth — OK for local demos)
QDRANT__SERVICE__API_KEY=
