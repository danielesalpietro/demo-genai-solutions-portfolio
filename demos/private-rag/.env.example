# Copy to .env and fill in the required values before running.
# Usage: cp .env.example .env && $EDITOR .env

# Required: at least 32 random characters.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=CHANGE_ME_32_CHAR_MIN

# Optional: leave empty for demo mode (no API key auth on Qdrant).
QDRANT__SERVICE__API_KEY=

# Optional: leave empty to use Ollama only (no OpenAI-compatible external endpoint).
OPENAI_API_BASE_URLS=
