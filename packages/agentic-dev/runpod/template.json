{
  "name": "agentic-dev demo",
  "imageName": "ghcr.io/{{GHCR_OWNER}}/demo-genai-solutions-portfolio/agentic-dev:latest",
  "dockerArgs": "",
  "containerDiskGB": 30,
  "volumeGB": 10,
  "volumeMountPath": "/workspace",
