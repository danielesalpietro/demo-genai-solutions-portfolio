{
  "name": "virtual-human demo",
  "imageName": "ghcr.io/{{GHCR_OWNER}}/demo-genai-solutions-portfolio/virtual-human:latest",
  "dockerArgs": "",
  "containerDiskGB": 30,
  "volumeGB": 10,
  "volumeMountPath": "/workspace",
  "ports": "3000/http,11434/tcp,5002/tcp,8000/http",
  "env": [
    {"key": "GPU_TIER", "value": "rtx5060ti"},
    {"key": "DEMO", "value": "virtual-human"}
  ],
  "gpuCount": 1,
  "startJupyter": false,
  "startSsh": true,
  "supportPublicIp": true
}